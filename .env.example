# Your Anthropic API key (console.anthropic.com → API keys). Stays on your machine.
ANTHROPIC_API_KEY=sk-ant-...

# Hard spending cap in USD. Crux refuses new AI calls once its own running estimate hits this.
BUDGET_USD=100

# Optional: default model (you can also switch in the app).
# claude-opus-5-5 | claude-sonnet-5-5 | claude-haiku-5-5 | claude-fable-5-2
# MODEL=claude-opus-5-5

# Optional: natural voices from ElevenLabs (elevenlabs.io → API keys). Without it, the browser's own voice is used.
# ELEVENLABS_API_KEY=sk_...
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_VOICES=voiceId1,voiceId2,voiceId3,voiceId4

# Optional: only needed if you host this somewhere public.
# HOST=0.0.0.0
# PORT=3000
# APP_PASSWORD=choose-something
